    "stages": {
      "hipnagogia": {
        "day": "2027-07-08",
        "label": "Hipnagogia",
        "subtitle": "Próg snu, gdy myśli zamieniają się w obrazy. Przyjazd, przekroczenie fosy, hipnoza i pierwsze rozmowy."
      },
      "sen": {
        "day": "2027-07-09",
        "label": "Sen głęboki",
        "subtitle": "Zejście. Najciemniejsza i najcichsza faza. Dzień ciała, cienia i tego, co leży najniżej."
      },
      "rem": {
        "day": "2027-07-10",
        "label": "REM",
        "subtitle": "Obrazy. Archetypy, relacje, Anima i Animus. Najdłuższa noc pod sceną Umbra."
      },
      "przebudzenie": {
        "day": "2027-07-11",
        "label": "Przebudzenie",
        "subtitle": "Powrót na powierzchnię. Zapamiętać sen, zanim zniknie. Integracja i wspólne zamknięcie."
      }
    },
    "zones": [
      {
        "id": "podswiadomosci",
        "name": "Strefa Podświadomości",
        "shortName": "Podświadomości",
        "color": "#A59CD3",
        "icon": "🌀",
        "subtitle": "Descensus",
        "description": "Komnata hipnozy i transu. Schodzimy pod próg czuwania, tam gdzie obrazy myślą za nas, a sen podsuwa klucze do drzwi, których nie szukaliśmy."
      },
      {
        "id": "sacrum",
        "name": "Strefa SACRUM",
        "shortName": "SACRUM",
        "color": "#D8B982",
        "icon": "🔥",
        "subtitle": "Lapis philosophorum",
        "description": "Wiedza o przemianie: psychologia głębi, terapia i granice ludzkiego doświadczenia. Kamień odrzucony przez budowniczych okazuje się kamieniem węgielnym."
      },
      {
        "id": "anima",
        "name": "Strefa Anima/Animus",
        "shortName": "Anima/Animus",
        "color": "#7DA2C9",
        "icon": "☯",
        "subtitle": "Coniunctio",
        "description": "Komnata zaślubin przeciwieństw. Męskie i żeńskie, światło i cień, ja i ty. Tu relacja staje się retortą, w której coś trzeciego może się narodzić."
      },
      {
        "id": "ciao",
        "name": "Strefa CIAO",
        "shortName": "CIAO",
        "color": "#C48A6A",
        "icon": "🧘",
        "subtitle": "Corpus",
        "description": "Ciało jako naczynie Dzieła. Ruch, oddech i dotyk. To, co rozum dawno zapomniał, mięśnie wciąż pamiętają."
      },
      {
        "id": "umbra",
        "name": "Scena Umbra",
        "shortName": "Umbra",
        "color": "#EF8448",
        "icon": "⚡",
        "subtitle": "Nigredo",
        "description": "Czerń, w której wszystko się rozpuszcza. Rozmowy za dnia, a nocą rytm do świtu i taniec z tym, co zwykle zostaje w cieniu."
      },
      {
        "id": "gnoza",
        "name": "Kino Gnoza",
        "shortName": "Kino Gnoza",
        "color": "#7FB59A",
        "icon": "🎬",
        "subtitle": "Speculum",
        "description": "Lustro z celuloidu. Film działa tu jak sen i hipnoza: oglądasz go, a on ogląda ciebie. Pokazy, rozmowy z twórcami, warsztaty."
      },
      {
        "id": "wszystkie",
